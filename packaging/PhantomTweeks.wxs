<?xml version="1.0" encoding="UTF-8"?>
<!--
  Phantom Tweeks MSI package (WiX Toolset v4).

  Produces a genuine Windows Installer database, which is what corporate
  deployment tools (Group Policy, Intune, SCCM) require. It installs the same
  payload as the Inno .exe installer: the application, docs, shortcuts, an
  optional PATH entry, and a proper Add/Remove Programs entry.

  Deliberate choices:
    * perMachine install, so every user on the PC gets it once.
    * MajorUpgrade is configured to replace older versions cleanly rather than
      installing side-by-side and leaving two entries in Add/Remove Programs.
    * The uninstaller removes program files ONLY. Backups and optimization
      history in %LOCALAPPDATA%\PhantomTweeks are deliberately preserved so a
      user who uninstalls can still restore their previous configuration.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="Phantom Tweeks"
      Manufacturer="Phantom Tweeks"
      Version="$(var.ProductVersion)"
      UpgradeCode="7C9E2F14-5B8A-4D3E-9A61-2F4C8D0E7B35"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">

    <SummaryInformation
        Description="Phantom Tweeks — Windows performance optimization suite"
        Manufacturer="Phantom Tweeks" />

    <!-- Windows 10 1809 or newer, matching the application's own requirement. -->
    <Launch
        Condition="Installed OR (VersionNT &gt;= 603)"
        Message="Phantom Tweeks requires Windows 10 version 1809 or newer." />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Phantom Tweeks is already installed. Uninstall it first if you really want to go back." />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="PhantomIcon" SourceFile="$(var.AssetsDir)\phantom.ico" />
    <Property Id="ARPPRODUCTICON" Value="PhantomIcon" />
    <Property Id="ARPHELPLINK" Value="https://phantomtweeks.example/support" />
    <Property Id="ARPURLINFOABOUT" Value="https://phantomtweeks.example" />
    <!-- Keep the uninstall entry honest: no "repair" that does nothing. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- EULA shown in the wizard. -->
    <?ifdef IncludeUI ?>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <?endif ?>

    <!-- The wizard UI needs WixToolset.UI.wixext. When that extension is not
         available the MSI is still built, just without the interactive UI;
         it remains fully usable via msiexec, which is the main reason the
         MSI exists. build.ps1 defines IncludeUI when the extension loaded. -->
    <?ifdef IncludeUI ?>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <?endif ?>

    <Feature Id="Main" Title="Phantom Tweeks" Level="1"
             Description="The application, documentation and shortcuts.">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="DocComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Feature Id="PathEntry" Title="Add to PATH" Level="1000"
             Description="Adds Phantom Tweeks to PATH so the command line interface works from any terminal.">
      <ComponentRef Id="PathComponent" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Phantom Tweeks">
        <Directory Id="DocsFolder" Name="docs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="Phantom Tweeks" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="A1B2C3D4-E5F6-4A7B-8C9D-0E1F2A3B4C5D">
        <File Id="PhantomTweeksExe"
              Source="$(var.DistDir)\PhantomTweeks.exe"
              KeyPath="yes" />
      </Component>
      <Component Id="AppIcon" Guid="B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E">
        <File Id="PhantomIcoFile"
              Source="$(var.AssetsDir)\phantom.ico"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DocComponents" Directory="DocsFolder">
      <Component Id="DocPrivacy" Guid="F6A7B8C9-D0E1-4F2A-3B4C-5D6E7F809112">
        <File Id="PrivacyDoc" Source="$(var.DocsDir)\PRIVACY.md" KeyPath="yes" />
      </Component>
      <Component Id="DocSecurity" Guid="A7B8C9D0-E1F2-4A3B-4C5D-6E7F80911223">
        <File Id="SecurityDoc" Source="$(var.DocsDir)\SECURITY.md" KeyPath="yes" />
      </Component>
      <Component Id="DocGuide" Guid="B8C9D0E1-F2A3-4B4C-5D6E-7F8091122334">
        <File Id="GuideDoc" Source="$(var.DocsDir)\USER_GUIDE.md" KeyPath="yes" />
      </Component>
      <Component Id="DocEula" Guid="C9D0E1F2-A3B4-4C5D-6E7F-809112233445">
        <File Id="EulaDoc" Source="$(var.DocsDir)\EULA.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcut" Directory="AppProgramMenuFolder"
               Guid="C3D4E5F6-A7B8-4C9D-0E1F-2A3B4C5D6E7F">
      <Shortcut Id="StartMenuPhantom"
                Name="Phantom Tweeks"
                Description="Optimize Smarter. Game Better."
                Target="[INSTALLFOLDER]PhantomTweeks.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="PhantomIcon" />
      <RemoveFolder Id="RemoveProgramMenuFolder"
                    Directory="AppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\PhantomTweeks"
                     Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder"
               Guid="D4E5F6A7-B8C9-4D0E-1F2A-3B4C5D6E7F80"
               Condition="INSTALLDESKTOPSHORTCUT = &quot;1&quot;">
      <Shortcut Id="DesktopPhantom"
                Name="Phantom Tweeks"
                Target="[INSTALLFOLDER]PhantomTweeks.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="PhantomIcon" />
      <RegistryValue Root="HKCU" Key="Software\PhantomTweeks"
                     Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="PathComponent" Directory="INSTALLFOLDER"
               Guid="E5F6A7B8-C9D0-4E1F-2A3B-4C5D6E7F8091">
      <Environment Id="AddToPath" Name="PATH" Value="[INSTALLFOLDER]"
                   Permanent="no" Part="last" Action="set" System="yes" />
      <RegistryValue Root="HKLM" Key="Software\PhantomTweeks"
                     Name="PathEntry" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Default the desktop shortcut on; the wizard/property can override. -->
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

  </Package>
</Wix>
